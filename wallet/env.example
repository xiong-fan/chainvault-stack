# Wallet 模块环境变量配置

# Signer 模块基础 URL (必需)
SIGNER_BASE_URL=http://localhost:3001

# 服务端口 (可选，默认为 3000)
PORT=3000

# Gateway Service URL
DATABASE_GATEWAY_URL=http://localhost:3003

# Risk Control Service URL
RISK_CONTROL_URL=http://localhost:3004

# 风控后台管理共享密钥
# 与 risk_control/.env 或根目录 keys.env 中的 RISK_ADMIN_TOKEN 保持一致。
# 仅服务端使用，不要放到 NEXT_PUBLIC_*。
RISK_ADMIN_TOKEN=replace_with_same_random_token_as_risk_control

# 首个后台管理员初始化密钥
# POST /api/admin/bootstrap 时使用；只用于首次创建 sys_admin/admin。
BOOTSTRAP_ADMIN_TOKEN=replace_with_one_time_bootstrap_token

WALLET_PRIVATE_KEY=

WALLET_DB_PATH=/Users/..../cex-wallet/db_gateway/wallet.db

# EVM RPC 配置
# 主 RPC 用于读链和广播；*_BACKUP 支持用英文逗号配置多个备用 RPC。
# 当主 RPC 对 eth_sendRawTransaction 返回 429 限流时，wallet 会短暂重试并切换备用 RPC。
SEPOLIA_RPC_URL=https://eth-sepolia.public.blastapi.io
SEPOLIA_RPC_URL_BACKUP=https://ethereum-sepolia-rpc.publicnode.com,https://rpc.sepolia.org
MAINNET_RPC_URL=https://eth.llamarpc.com
MAINNET_RPC_URL_BACKUP=
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_RPC_URL_BACKUP=
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_TESTNET_RPC_URL_BACKUP=
