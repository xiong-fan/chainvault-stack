# Server Configuration
PORT=3004
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (绝对路径)
# 例如: /Users/your_username/openspace_code/cex-wallet/risk_control/risk_control.db
RISK_CONTROL_DB_PATH=/absolute/path/to/risk_control.db

# Risk Control Private Key (Ed25519)
# Generate using: npm run generate-keypair
RISK_PRIVATE_KEY=your_private_key_here

# 风控后台管理共享密钥
# 与 wallet/.env 或根目录 keys.env 中的 RISK_ADMIN_TOKEN 保持一致。
# wallet 服务端代理后台请求时会携带该 token，risk_control 用它校验后台请求。
RISK_ADMIN_TOKEN=replace_with_same_random_token_as_wallet

WALLET_SERVICE_URL=http://localhost:3000
